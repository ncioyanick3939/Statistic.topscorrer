# Server-side AI configuration. Never commit real secrets.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_URL=https://api.anthropic.com/v1/messages

# Optional shared access code for AI requests.
APP_CODE=

# Default per-IP AI request limit per hour.
ASK_LIMIT_PER_HOUR=20

# Render sets PORT automatically.
PORT=3000
